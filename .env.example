# Frontend mode: personal or demo. These VITE_* values are public in the bundle.
VITE_APP_MODE=personal

# Optional opt-in live presentation. Use a public anon key with server-side RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only. Never prefix secrets with VITE_ and never set these on public demo hosting.
OPENAI_API_KEY=
TWELVE_DATA_API_KEY=
